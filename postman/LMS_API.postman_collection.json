{
  "info": {
    "name": "LMS API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Sample LMS API tests. Run in order (folders depend on the token saved by 'POST login - valid credentials'). Folder 00 resets the bundled mock LMS; skip it against a real LMS."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Setup",
      "item": [
        {
          "name": "Reset test data (mock LMS only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/test/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test",
                "reset"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "01 Health",
      "item": [
        {
          "name": "GET health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status is ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "02 Authentication",
      "item": [
        {
          "name": "POST login - valid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains a token', function () { var j = pm.response.json(); pm.expect(j.token).to.be.a('string').and.not.empty; pm.collectionVariables.set('token', j.token); });",
                  "pm.test('User name matches', function () { pm.expect(pm.response.json().user.username).to.eql(pm.collectionVariables.get('username')); });",
                  "pm.test('Response time under 2000 ms', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "POST login - wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Error message present', function () { pm.expect(pm.response.json().error).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"WrongPass!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "POST login - missing fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "POST login - locked account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 423', function () { pm.response.to.have.status(423); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"locked_user\",\n  \"password\": \"Password123!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "03 Courses",
      "item": [
        {
          "name": "GET courses - no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "GET courses - authenticated",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Catalog contains C101, C102 and C103', function () { var ids = pm.response.json().courses.map(function (c) { return c.id; }); pm.expect(ids).to.include.members(['C101','C102','C103']); });",
                  "pm.test('C103 is reported as full', function () { var c = pm.response.json().courses.filter(function (x) { return x.id === 'C103'; })[0]; pm.expect(c.full).to.be.true; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "04 Enrollment",
      "item": [
        {
          "name": "POST enroll - C101",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Enrollment echoes course id', function () { pm.expect(pm.response.json().enrollment.course_id).to.eql('C101'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/C101/enroll",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "C101",
                "enroll"
              ]
            }
          }
        },
        {
          "name": "POST enroll - duplicate C101",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 409', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/C101/enroll",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "C101",
                "enroll"
              ]
            }
          }
        },
        {
          "name": "POST enroll - full course C103",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('Error mentions course is full', function () { pm.expect(pm.response.json().error.toLowerCase()).to.include('full'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/C103/enroll",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "C103",
                "enroll"
              ]
            }
          }
        },
        {
          "name": "POST enroll - unknown course",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/C999/enroll",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "C999",
                "enroll"
              ]
            }
          }
        },
        {
          "name": "GET my enrollments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Contains C101 only', function () { pm.expect(pm.response.json().enrollments).to.eql(['C101']); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/enrollments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "enrollments"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "05 Assignments",
      "item": [
        {
          "name": "POST submission - no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assignments/A101/submissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assignments",
                "A101",
                "submissions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"answer\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "POST submission - valid text",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Attempt number is 1', function () { pm.expect(pm.response.json().submission.attempt).to.eql(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assignments/A101/submissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assignments",
                "A101",
                "submissions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"This is my answer for the assignment.\"\n}"
            }
          }
        },
        {
          "name": "POST submission - empty text",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assignments/A101/submissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assignments",
                "A101",
                "submissions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"   \"\n}"
            }
          }
        },
        {
          "name": "POST submission - past due (A103)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 422', function () { pm.response.to.have.status(422); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assignments/A103/submissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assignments",
                "A103",
                "submissions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"late\"\n}"
            }
          }
        },
        {
          "name": "POST submission - not enrolled (A102)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 403', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assignments/A102/submissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assignments",
                "A102",
                "submissions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"x\"\n}"
            }
          }
        }
      ]
    }
  ]
}